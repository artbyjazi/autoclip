[Unit]
Description=Clippy private video clipping backend
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=clippy
Group=clippy
WorkingDirectory=/opt/clippy
Environment=CLIPPY_HOME=/var/lib/clippy
Environment=CLIPPY_YOUTUBE_COOKIES_FILE=/var/lib/clippy/secrets/youtube-cookies.txt
Environment=PATH=/opt/clippy/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/clippy/.venv/bin/clippy serve --host 127.0.0.1 --port 8000 --no-open
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clippy
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
