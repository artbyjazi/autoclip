[Unit]
Description=Apply Clippy artifact retention policy
After=clippy.service

[Service]
Type=oneshot
User=clippy
Group=clippy
WorkingDirectory=/opt/clippy
Environment=CLIPPY_HOME=/var/lib/clippy
Environment=PATH=/opt/clippy/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/clippy/.venv/bin/clippy cleanup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clippy
