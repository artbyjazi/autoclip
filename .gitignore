# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Built frontend, emitted into the Python package by `npm run build`.
# Regenerated from source; a release build produces it during packaging.
backend/clippy/static/

# Clippy runtime artifacts
.clippy/
.autoclip/
*.db
*.sqlite3

# Test media (large binaries stay out of git; see tests/fixtures/README.md)
tests/fixtures/media/
tests/fixtures/**/*.mp4
tests/fixtures/**/*.mkv
tests/fixtures/**/*.webm
tests/fixtures/**/*.wav

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Secrets — never commit
.env
.env.*
!.env.example
